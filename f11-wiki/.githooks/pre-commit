#!/usr/bin/env bash
# LLM Wiki pre-commit gate. Install with: bash scripts/install_hooks.sh
#
# The vault is resolved from this script's own location, not from the git top level, so this
# works whether the wiki IS the repo or sits in a subfolder of a larger project repo.
set -euo pipefail

VAULT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$VAULT"

# --staged-only skips entirely when the commit touches nothing in the wiki, so commits to a
# surrounding project don't pay for a wiki build.
python3 scripts/wiki_tool.py gate --staged-only

# Re-stage any build artifacts the gate regenerated (vault-relative; we cd'd above).
git add Wiki/catalog.jsonl Wiki/index.md Wiki/*/index.md 2>/dev/null || true
